# Never commit actual passwords, keys, or connection strings.
TRUSTVAULT_SECRET=replace-with-long-random-secret
TRUSTVAULT_HTTPS=0

# Local private disk (development).
TRUSTVAULT_STORAGE_BACKEND=local
# TRUSTVAULT_STORAGE=C:\private\trustvault

# Production: Neon PostgreSQL + private Supabase Storage.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# TRUSTVAULT_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_BUCKET=trustvault-documents
# SUPABASE_SECRET_KEY=configure-only-in-host-secret-settings

# Set unique passwords before running scripts.seed or configuring Render.
SEED_ADMIN_PASSWORD=change-to-unique-long-secret
SEED_OWNER_PASSWORD=change-to-unique-long-secret
SEED_VIEWER_PASSWORD=change-to-unique-long-secret
SEED_OTHER_PASSWORD=change-to-unique-long-secret
